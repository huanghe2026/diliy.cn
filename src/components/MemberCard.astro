---
import type { Role } from '../data/team';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  role: Role;
  lang: Lang;
}
const { role, lang } = Astro.props;
const applyHref = lang === 'zh' ? '/zh/test' : '/test';
---

<div class="member-card">
  <div class="member-avatar">{role.avatar}</div>
  <div class="member-name">{role.name[lang]}</div>
  <div class="member-role">{role.role[lang]}</div>
  <p class="member-bio">{role.bio[lang]}</p>
  <div class="member-looking">
    <strong>{lang === 'zh' ? '我们在找：' : "We're looking for: "}</strong>
    {role.looking[lang]}
  </div>
  <a class="btn btn-primary" href={applyHref} style="width:100%; justify-content:center;">
    {t(lang, 'team_apply')}
  </a>
</div>
