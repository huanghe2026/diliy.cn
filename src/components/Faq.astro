---
import { faq } from '../data/faq';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="faq-list">
  {faq.map((item, i) => (
    <details class="faq-item" open={i === 0}>
      <summary>
        <span class="faq-q">{item.q[lang]}</span>
        <span class="faq-mark">+</span>
      </summary>
      <div class="faq-a">{item.a[lang]}</div>
    </details>
  ))}
</div>
