---
// SshHero v3 — 只有终端演示 + feature 徽章
// 标题/lead/CTA 已移到 Hero 底部（index.astro 的 .hero-ssh-entry）
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const sshCmd = 'ssh diliy.cn';
---

<section id="ssh-hero" class="ssh-section">
  <!-- 背景装饰 -->
  <div class="ssh-bg-deco" aria-hidden="true"></div>

  <div class="container ssh-grid">
    <!-- ════════ 终端场景（主展示区） ════════ -->
    <div class="terminal-scene">
      <!-- CRT 扫描线覆盖层 -->
      <div class="crt-overlay" aria-hidden="true"></div>
      <div class="crt-vignette" aria-hidden="true"></div>

      <!-- 终端窗口 -->
      <div class="terminal-window" id="ssh-terminal">
        <!-- 顶栏 -->
        <div class="terminal-bar">
          <div class="terminal-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <div class="terminal-title">geoyuan — zsh — 80×24</div>
          <button class="terminal-refresh" id="terminal-replay" title="Replay demo">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          </button>
        </div>

        <!-- 终端内容 (初始空，JS 逐行渲染) -->
        <div class="terminal-body" id="terminal-body"></div>

        <!-- 底栏 -->
        <div class="terminal-footer">
          <span class="footer-pill pill-green">
            <span class="pill-dot"></span> SSH ESTABLISHED
          </span>
          <span class="footer-pill pill-cyan">
            <span class="pill-dot"></span> AI GENERATOR ONLINE
          </span>
          <span class="footer-pill pill-purple">
            <span class="pill-dot"></span> ED25519 ENCRYPTED
          </span>
        </div>
      </div>
    </div>

    <!-- ════════ 右侧 feature 徽章 + CTA ════════ -->
    <div class="ssh-features-col">
      <div class="ssh-features">
        <div class="ssh-feature">
          <span class="feat-icon">{t(lang, 'ssh_feat1_icon')}</span>
          <div>
            <div class="feat-title">{t(lang, 'ssh_feat1_title')}</div>
            <div class="feat-desc">{t(lang, 'ssh_feat1_desc')}</div>
          </div>
        </div>
        <div class="ssh-feature">
          <span class="feat-icon">{t(lang, 'ssh_feat2_icon')}</span>
          <div>
            <div class="feat-title">{t(lang, 'ssh_feat2_title')}</div>
            <div class="feat-desc">{t(lang, 'ssh_feat2_desc')}</div>
          </div>
        </div>
        <div class="ssh-feature">
          <span class="feat-icon">{t(lang, 'ssh_feat3_icon')}</span>
          <div>
            <div class="feat-title">{t(lang, 'ssh_feat3_title')}</div>
            <div class="feat-desc">{t(lang, 'ssh_feat3_desc')}</div>
          </div>
        </div>
      </div>

      <div class="ssh-cta-row">
        <a href="ssh://diliy.cn" class="btn btn-primary btn-ssh">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
          Connect via SSH
        </a>
        <div class="ssh-cmd-box">
          <span class="ssh-cmd-prompt">$</span>
          <code class="ssh-cmd-text">{sshCmd}</code>
          <button class="ssh-copy-btn" id="ssh-copy-btn" title="Copy to clipboard">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // ═══════════════════════════════════════════════
  //  🎬 Terminal Animation Engine (same as v2)
  // ═══════════════════════════════════════════════
  const terminalBody = document.getElementById('terminal-body');
  const replayBtn = document.getElementById('terminal-replay');
  const copyBtn = document.getElementById('ssh-copy-btn');
  const sshCmdEl = document.getElementById('ssh-cmd-text');

  const FRAMES = [
    { t: 0,    type: 'line',  html: '<span class="prompt">root@your-box</span><span class="sep">:</span><span class="cwd">~</span><span class="sep">#</span>' },
    { t: 0,    type: 'cursor' },
    { t: 800,  type: 'cmd',   cmd: 'ssh diliy.cn', prompt: 'root@your-box' },
    { t: 2500, type: 'text',  cls: 'dim',    html: 'Connecting to diliy.cn:22...' },
    { t: 3200, type: 'text',  cls: 'dim',    html: 'Warning: Host key verified (ED25519)' },
    { t: 3800, type: 'logo' },
    { t: 5200, type: 'text',  cls: 'neon-text', html: '🛰️  Welcome, Traveler. New handle?' },
    { t: 6200, type: 'cmd',   cmd: 'ghost', prompt: 'geoyuan@diliy', sep: '❯' },
    { t: 7200, type: 'text',  cls: 'neon-text', html: '⚡ AI generating 30 questions...' },
    { t: 7200, type: 'loader' },
    { t: 9800, type: 'text',  cls: 'dim',    html: 'Q1/30  Which attention variant scales best?' },
    { t: 10500, type: 'text',  cls: 'dim',    html: '  A. Multi-Head    ➤  B. Grouped Query    C. Flash    D. Sparse' },
    { t: 13000, type: 'pass' },
    { t: 13500, type: 'text',  cls: 'neon-text', html: '✓ Approved. Joining private chat...' },
    { t: 14500, type: 'text',  cls: 'dim',    html: '[#geoyuan] 👥 Online: nyx, orphan, ghost, +3 more' },
  ];

  let timers = [];
  let running = false;

  function clearTimers() { timers.forEach(clearTimeout); timers = []; }
  function schedule(fn, ms) { timers.push(setTimeout(fn, ms)); }
  function escapeHtml(s) { return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

  const GEOYUAN_LOGO = [
    ' ██████╗ ███████╗ ██╗   ██╗ ██████╗ ██╗   ██╗ ██████╗ ██╗   ██╗',
    ' ██╔══██╗██╔════╝ ██║   ██║██╔═══██╗██║   ██║██╔═══██╗╚██╗ ██╔╝',
    ' ██████╔╝█████╗   ██║   ██║██║   ██║██║   ██║██║   ██║ ╚████╔╝ ',
    ' ██╔══██╗██╔══╝   ╚██╗ ██╔╝██║   ██║██║   ██║██║   ██║  ╚██╔╝  ',
    ' ██║  ██║███████╗  ╚████╔╝ ╚██████╔╝╚██████╔╝╚██████╔╝   ██║   ',
    ' ╚═╝  ╚═╝╚══════╝   ╚═══╝   ╚═════╝  ╚═════╝  ╚═════╝    ╚═╝   ',
  ];

  function renderLogoLines() {
    return GEOYUAN_LOGO.map(line =>
      `<div class="terminal-line neon-line"><span class="neon-logo">${escapeHtml(line)}</span></div>`
    ).join('');
  }

  function runAnimation() {
    if (running) return;
    running = true;
    clearTimers();
    terminalBody.innerHTML = '';

    for (const frame of FRAMES) {
      schedule(() => renderFrame(frame), frame.t);
    }

    schedule(() => {
      schedule(() => {
        running = false;
        if (observer && isVisible) runAnimation();
      }, 2000);
    }, 15000);
  }

  function renderFrame(frame) {
    switch (frame.type) {
      case 'line':
        terminalBody.insertAdjacentHTML('beforeend', `<div class="terminal-line">${frame.html}</div>`); break;
      case 'cursor':
        terminalBody.insertAdjacentHTML('beforeend', `<div class="terminal-line cursor-line"><span class="prompt">root@your-box</span><span class="sep">:</span><span class="cwd">~</span><span class="sep">#</span><span class="typing-cursor"></span></div>`); break;
      case 'cmd': {
        const cursorEl = terminalBody.querySelector('.cursor-line');
        const promptHtml = `<span class="prompt">${frame.prompt}</span><span class="sep">:</span><span class="cwd">~</span><span class="sep">${frame.sep || '#'}</span> `;
        if (cursorEl) {
          cursorEl.className = 'terminal-line';
          cursorEl.innerHTML = promptHtml +
            `<span class="typed-cmd" id="typing-target"></span><span class="typing-cursor" id="active-cursor"></span>`;
        } else {
          terminalBody.insertAdjacentHTML('beforeend',
            `<div class="terminal-line">${promptHtml}<span class="typed-cmd" id="typing-target"></span><span class="typing-cursor" id="active-cursor"></span></div>`);
        }
        const target = document.getElementById('typing-target');
        const cursor = document.getElementById('active-cursor');
        if (target) {
          let i = 0;
          const typeInterval = setInterval(() => {
            if (i < frame.cmd.length) { target.textContent += frame.cmd[i++]; terminalBody.scrollTop = terminalBody.scrollHeight; }
            else { clearInterval(typeInterval); if (cursor) cursor.remove(); }
          }, 55);
          timers.push(typeInterval);
        }
        break;
      }
      case 'text':
        terminalBody.insertAdjacentHTML('beforeend',
          `<div class="terminal-line ${frame.cls || ''}">${frame.html}</div>`); break;
      case 'logo':
        terminalBody.insertAdjacentHTML('beforeend', renderLogoLines()); break;
      case 'loader':
        terminalBody.insertAdjacentHTML('beforeend',
          `<div class="terminal-line loader-line"><span class="loader-dots"><span>.</span><span>.</span><span>.</span></span></div>`);
        schedule(() => { const l = terminalBody.querySelector('.loader-line'); if (l) l.remove(); }, 3500);
        break;
      case 'pass':
        terminalBody.insertAdjacentHTML('beforeend',
          `<div class="terminal-line pass-line"><span class="pass-text">🎉  PASS — 27/30 (90%)</span></div>`); break;
    }
    // ⭐️ 自动滚到底，确保新行可见
    terminalBody.scrollTop = terminalBody.scrollHeight;
  }

  let isVisible = false, observer;
  function setupObserver() {
    const target = document.getElementById('ssh-hero');
    if (!target || !('IntersectionObserver' in window)) { runAnimation(); return; }
    observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        isVisible = entry.isIntersecting && entry.intersectionRatio > 0.2;
        if (isVisible && !running) runAnimation();
      }
    }, { threshold: [0.2, 0.5, 0.8] });
    observer.observe(target);
  }

  replayBtn?.addEventListener('click', () => { clearTimers(); running = false; runAnimation(); });

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(sshCmd);
      copyBtn.classList.add('copied');
      copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
      }, 2200);
    } catch (e) {
      const ta = document.createElement('textarea');
      ta.value = sshCmd;
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
      copyBtn.classList.add('copied');
      copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
      }, 2200);
    }
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupObserver);
  else setupObserver();
</script>

<style>
  /* ═════════════════════════════════════════════════
     🎨 Hero 底部 SSH 入口卡（全局共享）
     ═════════════════════════════════════════════════ */
  .hero-ssh-entry {
    display: block;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(199, 125, 255, 0.25);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(.2,.8,.2,1);
    position: relative;
    overflow: hidden;
  }
  .hero-ssh-entry::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(199, 125, 255, 0.06), transparent 50%, rgba(0, 245, 255, 0.04));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .hero-ssh-entry:hover {
    border-color: rgba(0, 245, 255, 0.5);
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgba(0, 245, 255, 0.15),
      0 12px 40px -10px rgba(0, 245, 255, 0.2);
  }
  .hero-ssh-entry:hover::before { opacity: 1; }
  .hero-ssh-entry-inner { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 0.3rem; }

  .hero-ssh-label {
    font-size: 0.72rem;
    font-family: 'JetBrains Mono', monospace;
    color: #8b8b8b;
    letter-spacing: 0.05em;
  }
  .hero-ssh-title { margin: 0.2rem 0; }
  .hero-ssh-neon {
    background: linear-gradient(120deg, #c77dff 0%, #00f5ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 1.25rem;
  }
  .hero-ssh-lead {
    color: #8b8b8b;
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0.3rem 0 0.6rem;
    max-width: 580px;
  }
  .hero-ssh-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-ssh-cmd {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: #e0e0e0;
    background: rgba(0,0,0,0.4);
    padding: 0.25rem 0.55rem;
    border-radius: 5px;
    border: 1px solid rgba(199, 125, 255, 0.3);
  }
  .hero-ssh-cmd-prompt { color: #00f5ff; font-weight: 600; margin-right: 4px; }
  .hero-ssh-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    color: #00ff9d;
  }
  .hero-live-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #00ff9d;
    animation: livePulse 2s ease-in-out infinite;
  }
  @keyframes livePulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0, 255, 157, 0.7); }
    50%      { box-shadow: 0 0 0 4px rgba(0, 255, 157, 0); }
  }
  .hero-ssh-arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 0.9rem;
    font-size: 1.2rem;
    color: rgba(0, 245, 255, 0.5);
    animation: arrowBounce 2s ease-in-out infinite;
  }
  @keyframes arrowBounce {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50%      { transform: translateY(4px); opacity: 1; }
  }
  @media (max-width: 600px) {
    .hero-ssh-entry { padding: 1rem 1.1rem; margin-top: 1.5rem; }
    .hero-ssh-neon { font-size: 1.05rem; }
    .hero-ssh-lead { font-size: 0.82rem; }
    .hero-ssh-arrow { display: none; }
  }

  /* ═════════════════════════════════════════════════
     🎨 SshHero 主体 (terminal + features)
     ═════════════════════════════════════════════════ */
  .ssh-section {
    padding: 4rem 0 5rem;
    background: var(--bg);
    position: relative;
    overflow: hidden;
  }
  .ssh-bg-deco {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 50% 40% at 80% 30%, rgba(0, 245, 255, 0.10), transparent 60%),
      radial-gradient(ellipse 40% 50% at 15% 70%, rgba(199, 125, 255, 0.08), transparent 60%);
  }

  .ssh-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 960px) {
    .ssh-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .ssh-features-col { order: -1; } /* features 在上 */
  }

  /* 右侧 feature 列 */
  .ssh-features-col { display: flex; flex-direction: column; gap: 2rem; }

  .ssh-features {
    display: flex; flex-direction: column; gap: 0.65rem;
  }
  .ssh-feature {
    display: flex; gap: 0.75rem; align-items: flex-start;
    padding: 0.7rem 0.9rem;
    border: 1px solid rgba(0, 255, 157, 0.12);
    border-radius: 10px;
    background: rgba(0, 255, 157, 0.025);
    transition: transform 0.3s cubic-bezier(.2,.8,.2,1), border-color 0.3s, background 0.3s;
  }
  .ssh-feature:hover {
    border-color: rgba(0, 255, 157, 0.35);
    background: rgba(0, 255, 157, 0.06);
    transform: translateX(5px);
  }
  .feat-icon { font-size: 1.3rem; line-height: 1; }
  .feat-title { color: var(--text); font-weight: 600; font-size: 0.92rem; }
  .feat-desc { color: var(--muted); font-size: 0.8rem; margin-top: 2px; line-height: 1.4; }

  .ssh-cta-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .btn-ssh { font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; display: inline-flex; align-items: center; }
  .ssh-cmd-box {
    display: flex; align-items: center; gap: 0.45rem;
    padding: 0.42rem 0.65rem;
    background: rgba(0,0,0,0.4);
    border: 1px solid rgba(199,125,255,0.25);
    border-radius: 7px;
    font-family: 'JetBrains Mono', monospace; font-size: 0.82rem;
    transition: border-color 0.2s;
  }
  .ssh-cmd-box:hover { border-color: rgba(199,125,255,0.5); }
  .ssh-cmd-prompt { color: #00f5ff; font-weight: 600; }
  .ssh-copy-btn {
    display: flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 5px;
    background: transparent; border: 1px solid rgba(255,255,255,0.1);
    color: #666; cursor: pointer; transition: all 0.2s;
  }
  .ssh-copy-btn:hover { color: #00f5ff; border-color: rgba(0,245,255,0.4); background: rgba(0,245,255,0.08); }
  .ssh-copy-btn.copied { color: #00ff9d; border-color: rgba(0,255,157,0.5); }

  /* ═════════════════════════════════════════════════
     🖥️ 终端场景 (与 v2 相同)
     ═════════════════════════════════════════════════ */
  .terminal-scene { position: relative; }
  .crt-overlay {
    position: absolute; inset: 0; pointer-events: none; z-index: 5; border-radius: 12px;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,0.08) 0px, rgba(0,0,0,0.08) 1px, transparent 1px, transparent 3px);
    mix-blend-mode: multiply; opacity: 0.4;
  }
  .crt-vignette {
    position: absolute; inset: 0; pointer-events: none; z-index: 6; border-radius: 12px;
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.5);
  }
  .terminal-window {
    border-radius: 12px; overflow: hidden;
    background: #0a0a0f;
    border: 1px solid rgba(199, 125, 255, 0.25);
    position: relative;
    animation: neonBorderPulse 4s ease-in-out infinite;
    box-shadow: 0 0 0 1px rgba(0,245,255,0.1), 0 30px 80px -20px rgba(199,125,255,0.25), 0 0 40px -10px rgba(0,245,255,0.15);
  }
  @keyframes neonBorderPulse {
    0%, 100% { border-color: rgba(199,125,255,0.25); }
    50%      { border-color: rgba(0,245,255,0.4); }
  }
  .terminal-bar {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.55rem 1rem;
    background: linear-gradient(180deg, #141420, #0f0f1a);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .terminal-dots { display: flex; gap: 0.4rem; }
  .dot { width: 12px; height: 12px; border-radius: 50%; transition: transform 0.2s; }
  .dot:hover { transform: scale(1.15); }
  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }
  .terminal-title { flex: 1; text-align: center; font-size: 0.75rem; color: #555; font-family: 'JetBrains Mono', monospace; letter-spacing: 0.02em; }
  .terminal-refresh {
    display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; background: transparent; border: none;
    color: #666; cursor: pointer; border-radius: 6px; transition: all 0.2s;
  }
  .terminal-refresh:hover { color: #00f5ff; background: rgba(0,245,255,0.1); transform: rotate(180deg); }
  .terminal-refresh:active { transform: rotate(360deg); }

  .terminal-body {
    padding: 0.9rem 1.1rem;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.78rem; line-height: 1.6;
    min-height: 460px; max-height: 560px;
    overflow-y: auto; overflow-x: hidden;
    scroll-behavior: smooth;
  }
  /* ⭐️ 自定义滚动条 — 隐藏但可滚动 */
  .terminal-body::-webkit-scrollbar { width: 6px; }
