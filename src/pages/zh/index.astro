---
import Base from '../../layouts/Base.astro';
import Sponsor from '../../components/Sponsor.astro';
import Qualify from '../../components/Qualify.astro';
import SshHero from '../../components/SshHero.astro';
import { t, type Lang } from '../../i18n/ui';

const lang: Lang = 'zh';
const stack = ['Python', 'C / C++', 'Rust', 'Assembly', 'Ghidra', 'IDA Pro', 'Radare2', 'Wireshark', 'Burp Suite', 'Linux', 'Docker', 'Git', 'tmux', 'neovim'];
---

<Base lang={lang} title="diliy.cn/ — Geoyuan 团队" description="Geoyuan——一支无国界、AI 原生的开发团队，正向网络国家进发。完成智能时代的资格挑战，证明你属于这里并申请加入。">
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="terminal-label">{t(lang, 'hero_terminal')}</div>
        <h1>
          {t(lang, 'hero_title_1')}<br />
          <span class="glitch">{t(lang, 'hero_title_2')}</span><span class="cursor"></span>
        </h1>
        <p class="tagline">{t(lang, 'hero_tagline')}</p>
        <div class="cta-row">
          <a href="#join" class="btn btn-primary">{t(lang, 'cta_join')}</a>
          <a href="#team" class="btn btn-ghost">{t(lang, 'cta_meet')}</a>
        </div>
      </div>

      <!-- SSH 招募入口（hero 底部） -->
      <a href="#ssh-hero" class="hero-ssh-entry">
        <div class="hero-ssh-entry-inner">
          <div class="hero-ssh-label">{t(lang, 'ssh_label')}</div>
          <div class="hero-ssh-title">
            <span class="hero-ssh-neon">{t(lang, 'ssh_title')}</span>
          </div>
          <p class="hero-ssh-lead">{t(lang, 'ssh_lead')}</p>
          <div class="hero-ssh-meta">
            <div class="hero-ssh-cmd"><span class="hero-ssh-cmd-prompt">$</span> ssh diliy.cn</div>
            <div class="hero-ssh-live">
              <span class="hero-live-dot"></span>
              SSH 服务器在线 · diliy.cn:22
            </div>
          </div>
        </div>
        <div class="hero-ssh-arrow" aria-hidden="true">↓</div>
      </a>
    </div>
  </section>

  <Qualify lang={lang} />

  <section id="about">
    <div class="container">
      <div class="section-label">{t(lang, 'about_label')}</div>
      <div class="about-grid">
        <div class="about-text">
          <h2>{t(lang, 'about_title')}</h2>
          <p>{t(lang, 'about_p1')}</p>
          <p>{t(lang, 'about_p2')}</p>
        </div>
        <div class="stats">
          <div class="stat-card"><div class="stat-value">47</div><div class="stat-label">{t(lang, 'stat_ctf_label')}</div></div>
          <div class="stat-card"><div class="stat-value">12</div><div class="stat-label">{t(lang, 'stat_members_label')}</div></div>
          <div class="stat-card"><div class="stat-value">∞</div><div class="stat-label">{t(lang, 'stat_coffee_label')}</div></div>
          <div class="stat-card"><div class="stat-value">3</div><div class="stat-label">{t(lang, 'stat_0day_label')}</div></div>
        </div>
      </div>
    </div>
  </section>

  <section id="team">
    <div class="container">
      <div class="section-label">{t(lang, 'team_label')}</div>
      <h2>{t(lang, 'team_title')}</h2>
      <div class="team-grid">
        <div class="member-card">
          <div class="member-avatar">NX</div>
          <div class="member-name">nyx</div>
          <div class="member-role">负责人 / 逆向</div>
          <p class="member-bio">住在 IDA 与 Ghidra 里。说 x86 比说英语还溜。</p>
        </div>
        <div class="member-card">
          <div class="member-avatar">ØR</div>
          <div class="member-name">orphan</div>
          <div class="member-role">web / pwn</div>
          <p class="member-bio">XSS 是一种生活方式。至今仍对 log4j 耿耿于怀。</p>
        </div>
        <div class="member-card">
          <div class="member-avatar">GH</div>
          <div class="member-name">ghost</div>
          <div class="member-role">基础设施 / 运维</div>
          <p class="member-bio">让服务器不宕、噪声不响。偏好匿名。</p>
        </div>
        <div class="member-card">
          <div class="member-avatar">VK</div>
          <div class="member-name">v0idk1tten</div>
          <div class="member-role">恶意软件分析</div>
          <p class="member-bio">早餐拆解勒索软件。午餐配猫猫表情包。</p>
        </div>
      </div>
    </div>
  </section>

  <section id="stack">
    <div class="container">
      <div class="section-label">{t(lang, 'stack_label')}</div>
      <h2>{t(lang, 'stack_title')}</h2>
      <p style="color: var(--muted); max-width: 500px;">{t(lang, 'stack_desc')}</p>
      <div class="stack-grid">
        {stack.map((s) => <span class="stack-tag">{s}</span>)}
      </div>
    </div>
  </section>

  <SshHero lang={lang} />

  <section id="geo">
    <div class="container">
      <div class="section-label">{t(lang, 'geo_label')}</div>
      <h2>{t(lang, 'geo_title')}</h2>
      <p style="color: var(--muted); max-width: 620px;">{t(lang, 'geo_desc')}</p>
      <ul class="geo-list">
        <li>{t(lang, 'geo_p1')}</li>
        <li>{t(lang, 'geo_p2')}</li>
        <li>{t(lang, 'geo_p3')}</li>
      </ul>
    </div>
  </section>

  <section class="cta-section" id="join">
    <div class="container">
      <div class="section-label" style="justify-content: center; display: flex;">{t(lang, 'join_label')}</div>
      <h2>{t(lang, 'join_title')}</h2>
      <p>{t(lang, 'join_desc')}</p>
      <a href={`mailto:${t(lang, 'join_email')}`} class="btn btn-primary">{t(lang, 'join_email')}</a>
    </div>
  </section>

  <Sponsor lang={lang} />
</Base>
